# CodeGraph template env — copy to backend/.env and fill in.

# Primary provider (get one free at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# v4 provider chain (backend/codegraph/providers.yaml): NIM is primary; these
# optional keys add failover when NIM rate-limits. Any key left unset simply
# drops that provider from the chain — no code or config edits needed.
# OPENROUTER_API_KEY=sk-or-...        (https://openrouter.ai — free models, 20 rpm)
# GEMINI_API_KEY=AIza...              (https://aistudio.google.com/apikey)
# GROQ_API_KEY=gsk_...                (https://console.groq.com)

# Optional: override NIM model tiers (any model id works — see providers.yaml)
# CODEGRAPH_MODEL_EXPLAIN=nvidia/nemotron-3.5-lightning-30b-a3b
# CODEGRAPH_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b

# Optional: GitHub token for PR creation by the agent (/agent/task).
# If unset, the agent tries the `gh` CLI, then leaves a local commit on the branch.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
